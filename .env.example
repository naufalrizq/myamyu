# Vite: URL backend untuk frontend (ganti saat deploy ke Vercel)
# VITE_API_BASE_URL=https://api.myamyu.com

PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myamyu?schema=public"

# Auth
JWT_SECRET=change-this-to-random-secret-in-production
JWT_EXPIRES_IN=7d

# Safety stock default (stok cadangan yg dikurangi sebelum publish ke marketplace)
SAFETY_STOCK_DEFAULT=2

# URL callback OAuth (ganti dengan URL backend production saat deploy)
SHOPEE_REDIRECT_URL=http://127.0.0.1:3001/api/marketplaces/shopee/callback

# ── Shopee Open Platform ──────────────────────────────────────────────────────
# Production: https://partner.shopeemobile.com
# Sandbox:    https://partner.test-stable.shopeemobile.com
# Docs:       https://open.shopee.com/
# Cara setup sandbox:
#   1. Daftar akun developer di https://open.shopee.com/ → Console
#   2. Buat App → dapat PARTNER_ID dan PARTNER_KEY
#   3. Set BASE_URL ke sandbox: https://partner.test-stable.shopeemobile.com
#   4. Test OAuth: redirect URL harus URL backend lokal + ngrok
#   5. Untuk production: ganti BASE_URL dan PARTNER_ID/PARTNER_KEY asli
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_BASE_URL=https://partner.test-stable.shopeemobile.com

# ── TikTok Shop Partner Center ────────────────────────────────────────────────
# Sandbox & Production pakai URL yang sama, bedanya di credential app.
# TikTok Shop menggunakan "Development Shop" (sandbox) di Partner Center.
# Docs:       https://partner.tiktokshop.com/docv2
# Cara setup sandbox:
#   1. Daftar di https://partner.tiktokshop.com/ → Partner Center
#   2. Buat App → dapat APP_KEY dan APP_SECRET
#   3. Masuk Development Kits → Sandbox → Seller test accounts
#   4. Buat "Core Function Account" (tanpa KYC) untuk testing API
#   5. Authorize App dengan test shop tersebut
#   6. Untuk production: ganti APP_KEY/APP_SECRET dengan credential production
TTS_APP_KEY=
TTS_APP_SECRET=
TTS_BASE_URL=https://open-api.tiktokglobalshop.com

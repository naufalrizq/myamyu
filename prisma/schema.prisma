// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// MyaMyu Pet Store - Database Schema
// PostgreSQL
// =========================================================

model User {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  email           String   @unique @db.VarChar(150)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  stockMovements  StockMovement[]
  opnameSessions  OpnameSession[]  @relation("OpnameCreator")
  approvedOpname  OpnameSession[]  @relation("OpnameApprover")
  countedItems    OpnameItem[]

  @@map("users")
}

model Supplier {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(150)
  contactName     String?  @map("contact_name") @db.VarChar(100)
  phone           String?  @db.VarChar(30)
  email           String?  @db.VarChar(150)
  address         String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  stockMovements  StockMovement[]

  @@map("suppliers")
}

model Category {
  id              Int      @id @default(autoincrement())
  name            String   @unique @db.VarChar(100)
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")

  products        Product[]

  @@map("categories")
}

model Product {
  id              Int      @id @default(autoincrement())
  sku             String   @unique @db.VarChar(50)
  name            String   @db.VarChar(150)
  categoryId      Int?     @map("category_id")
  unit            String   @default("pcs") @db.VarChar(20)
  purchasePrice   Decimal  @default(0) @map("purchase_price") @db.Decimal(12,2)
  sellingPrice    Decimal  @default(0) @map("selling_price") @db.Decimal(12,2)
  minStock        Int      @default(0) @map("min_stock")
  currentStock    Int      @default(0) @map("current_stock")
  imageUrl        String?  @map("image_url")
  isPerishable    Boolean  @default(false) @map("is_perishable")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category        Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches         ProductBatch[]
  stockMovements  StockMovement[]
  opnameItems     OpnameItem[]
  channelMappings ProductChannelMapping[]
  syncJobs        StockSyncJob[]

  @@map("products")
  @@index([categoryId])
  @@index([sku])
}

model ProductBatch {
  id              Int      @id @default(autoincrement())
  productId       Int      @map("product_id")
  batchCode       String?  @map("batch_code") @db.VarChar(50)
  quantity        Int      @default(0)
  expiredDate     DateTime? @map("expired_date") @db.Date
  receivedDate    DateTime @default(now()) @map("received_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at")

  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_batches")
  @@index([productId])
  @@index([expiredDate])
}

model StockMovement {
  id              Int      @id @default(autoincrement())
  productId       Int      @map("product_id")
  type            String   @db.VarChar(20)
  quantity        Int
  referenceType   String?  @map("reference_type") @db.VarChar(30)
  referenceId     Int?     @map("reference_id")
  supplierId      Int?     @map("supplier_id")
  note            String?
  createdBy       Int      @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier        Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  creator         User         @relation(fields: [createdBy], references: [id])

  @@map("stock_movements")
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model OpnameSession {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(30)
  title           String?  @db.VarChar(150)
  status          String   @default("draft") @db.VarChar(20)
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdBy       Int      @map("created_by")
  approvedBy      Int?     @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  creator         User           @relation("OpnameCreator", fields: [createdBy], references: [id])
  approver        User?          @relation("OpnameApprover", fields: [approvedBy], references: [id])
  items           OpnameItem[]

  @@map("opname_sessions")
}

model OpnameItem {
  id              Int      @id @default(autoincrement())
  sessionId       Int      @map("session_id")
  productId       Int      @map("product_id")
  systemStock     Int      @map("system_stock")
  physicalStock   Int?     @map("physical_stock")
  difference      Int?
  note            String?
  countedBy       Int?     @map("counted_by")
  countedAt       DateTime? @map("counted_at")
  createdAt       DateTime @default(now()) @map("created_at")

  session         OpnameSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  counter         User?          @relation(fields: [countedBy], references: [id])

  @@unique([sessionId, productId])
  @@map("opname_items")
  @@index([sessionId])
  @@index([productId])
}

model MarketplaceAccount {
  id              Int      @id @default(autoincrement())
  marketplace     String   @db.VarChar(30)
  shopId          String   @map("shop_id") @db.VarChar(100)
  shopName        String?  @map("shop_name") @db.VarChar(150)
  accessToken     String?  @map("access_token")
  refreshToken    String?  @map("refresh_token")
  tokenExpiresAt  DateTime? @map("token_expires_at")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  productMappings ProductChannelMapping[]
  syncJobs        StockSyncJob[]

  @@unique([marketplace, shopId])
  @@map("marketplace_accounts")
}

model ProductChannelMapping {
  id                     Int      @id @default(autoincrement())
  productId              Int      @map("product_id")
  marketplaceAccountId   Int      @map("marketplace_account_id")
  externalProductId      String   @map("external_product_id") @db.VarChar(100)
  externalVariantId      String?  @map("external_variant_id") @db.VarChar(100)
  externalSku            String?  @map("external_sku") @db.VarChar(100)
  safetyStock            Int      @default(0) @map("safety_stock")
  lastSyncedStock        Int?     @map("last_synced_stock")
  lastSyncedAt           DateTime? @map("last_synced_at")
  syncStatus             String   @default("pending") @map("sync_status") @db.VarChar(30)
  syncError              String?  @map("sync_error")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  product                Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplaceAccount     MarketplaceAccount   @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  @@unique([marketplaceAccountId, externalProductId, externalVariantId])
  @@map("product_channel_mappings")
}

model StockSyncJob {
  id                     Int      @id @default(autoincrement())
  productId              Int      @map("product_id")
  marketplaceAccountId   Int?     @map("marketplace_account_id")
  targetStock            Int      @map("target_stock")
  status                 String   @default("queued") @db.VarChar(30)
  attempts               Int      @default(0)
  lastError              String?  @map("last_error")
  createdAt              DateTime @default(now()) @map("created_at")
  processedAt            DateTime? @map("processed_at")

  product                Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplaceAccount     MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id], onDelete: SetNull)

  @@map("stock_sync_jobs")
}
